{
  "openapi": "3.0.3",
  "info": {
    "title": "Bassline public event details (incremental contract)",
    "version": "0.1.0",
    "description": "Implemented in the monolith as the first extraction step. Covers only the new event-details endpoint, not the complete Discovery API. Move into services/discovery and extend when extracting."
  },
  "paths": {
    "/api/events/{event_id}/": {
      "get": {
        "operationId": "getPublicEvent",
        "description": "Public visibility only, regardless of signed-in identity. Past and cancelled public events remain available. Hidden, unapproved, unclassified and missing events all return the same 404.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public event details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "404": {
            "description": "Event unavailable or missing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "Event not found."
                      ]
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "starts_at",
          "ends_at",
          "cancelled",
          "venue"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "cancelled": {
            "type": "boolean"
          },
          "venue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "timezone"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "name": {
                "type": "string"
              },
              "timezone": {
                "type": "string",
                "example": "Europe/Paris"
              }
            }
          }
        }
      }
    }
  }
}
